{
  "name": "structura",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=structura-source vite --configLoader native",
    "build": "tsc -b && NODE_OPTIONS=--conditions=structura-source vite --configLoader native build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --conditions=structura-source --import ./tests/support/alias.ts --test \"tests/**/*.test.ts\" \"packages/*/tests/**/*.test.ts\" \"backend/tests/**/*.test.ts\"",
    "test:app": "node --experimental-strip-types --conditions=structura-source --import ./tests/support/alias.ts --test \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test -c e2e",
    "backend": "node --experimental-strip-types --conditions=structura-source backend/src/main.ts",
    "preview": "NODE_OPTIONS=--conditions=structura-source vite --configLoader native preview",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@rdkit/rdkit": "^2026.3.6",
    "@structura/ai": "*",
    "@structura/core": "*",
    "@structura/engine": "*",
    "@structura/markush": "*",
    "@structura/rdkit": "*",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@structura/testkit": "*",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "workspaces": [
    "packages/*",
    "backend"
  ]
}
