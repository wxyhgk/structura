{
  "name": "@structura/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Structura 的 AI 助手：用大模型（Claude 或 OpenAI Responses API）从专利文字读出通式变量的定义。服务器端调用模型，浏览器端校验和预览。",
  "type": "module",
  "exports": {
    ".": {
      "structura-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "structura-source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run build -w @structura/core && tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --conditions=structura-source --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@resvg/resvg-js": "^2.6.2",
    "@structura/core": "*",
    "openai": "^7.27.0"
  }
}
