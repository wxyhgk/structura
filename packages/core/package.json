{
  "name": "@structura/core",
  "version": "0.1.0",
  "private": true,
  "description": "Structura 的化学核心：分子模型、操作层（ops）、文件读写、出图，以及通式的数据模型和校验（展开成化合物在 @structura/markush）。不依赖浏览器和 React。",
  "type": "module",
  "exports": {
    ".": {
      "structura-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./analysis": {
      "structura-source": "./src/analysis.ts",
      "types": "./dist/analysis.d.ts",
      "default": "./dist/analysis.js"
    },
    "./constants": {
      "structura-source": "./src/constants.ts",
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./document": {
      "structura-source": "./src/document.ts",
      "types": "./dist/document.d.ts",
      "default": "./dist/document.js"
    },
    "./draw": {
      "structura-source": "./src/draw.ts",
      "types": "./dist/draw.d.ts",
      "default": "./dist/draw.js"
    },
    "./drawing": {
      "structura-source": "./src/drawing.ts",
      "types": "./dist/drawing.d.ts",
      "default": "./dist/drawing.js"
    },
    "./elements": {
      "structura-source": "./src/elements.ts",
      "types": "./dist/elements.d.ts",
      "default": "./dist/elements.js"
    },
    "./formula": {
      "structura-source": "./src/formula.ts",
      "types": "./dist/formula.d.ts",
      "default": "./dist/formula.js"
    },
    "./geometry": {
      "structura-source": "./src/geometry.ts",
      "types": "./dist/geometry.d.ts",
      "default": "./dist/geometry.js"
    },
    "./history": {
      "structura-source": "./src/history.ts",
      "types": "./dist/history.d.ts",
      "default": "./dist/history.js"
    },
    "./import": {
      "structura-source": "./src/import.ts",
      "types": "./dist/import.d.ts",
      "default": "./dist/import.js"
    },
    "./markush": {
      "structura-source": "./src/markush.ts",
      "types": "./dist/markush.d.ts",
      "default": "./dist/markush.js"
    },
    "./molecule": {
      "structura-source": "./src/molecule.ts",
      "types": "./dist/molecule.d.ts",
      "default": "./dist/molecule.js"
    },
    "./molfile": {
      "structura-source": "./src/molfile.ts",
      "types": "./dist/molfile.d.ts",
      "default": "./dist/molfile.js"
    },
    "./ops": {
      "structura-source": "./src/ops.ts",
      "types": "./dist/ops.d.ts",
      "default": "./dist/ops.js"
    },
    "./sdf": {
      "structura-source": "./src/sdf.ts",
      "types": "./dist/sdf.d.ts",
      "default": "./dist/sdf.js"
    },
    "./scaffolds": {
      "structura-source": "./src/scaffolds.ts",
      "types": "./dist/scaffolds.d.ts",
      "default": "./dist/scaffolds.js"
    },
    "./templates": {
      "structura-source": "./src/templates.ts",
      "types": "./dist/templates.d.ts",
      "default": "./dist/templates.js"
    },
    "./types": {
      "structura-source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./validate": {
      "structura-source": "./src/validate.ts",
      "types": "./dist/validate.d.ts",
      "default": "./dist/validate.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --conditions=structura-source --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@structura/testkit": "*"
  }
}
