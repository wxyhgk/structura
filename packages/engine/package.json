{
  "name": "@structura/engine",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Structura 的交互引擎：快捷键、命中检测、吸附、工具、视图换算和每个用户动作对应的操作。不依赖 React 和浏览器。",
  "type": "module",
  "exports": {
    ".": {
      "structura-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run build -w @structura/core && npm run build -w @structura/markush && tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --conditions=structura-source --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@structura/core": "*",
    "@structura/markush": "*"
  },
  "devDependencies": {
    "@structura/testkit": "*"
  }
}
