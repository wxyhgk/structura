{
  "name": "@structura/markush",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Structura 的通式（Markush）：把通式展开成具体化合物（批量生成、代表结构）、从文字读出候选项、关于变量和位点的查询。通式的数据模型和校验在 @structura/core。",
  "type": "module",
  "exports": {
    ".": {
      "structura-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run build -w @structura/core && tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --conditions=structura-source --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@structura/core": "*"
  },
  "devDependencies": {
    "@structura/testkit": "*"
  }
}
