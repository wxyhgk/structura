{
  "name": "chem-structura",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Structura：ChemDraw 风格的 2D 化学结构编辑器 React 组件，支持专利通式（Markush）的绘制和批量生成。",
  "type": "module",
  "exports": {
    ".": {
      "structura-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": {
      "structura-source": "./src/style.css",
      "default": "./dist/style.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --conditions=structura-source --test \"tests/**/*.test.ts\"",
    "build": "NODE_OPTIONS=--conditions=structura-source vite build --configLoader native && node scripts/build-types.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@rdkit/rdkit": "2026.3.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@structura/ai": "*",
    "@structura/core": "*",
    "@structura/engine": "*",
    "@structura/markush": "*",
    "@structura/rdkit": "*",
    "@structura/testkit": "*",
    "rolldown-plugin-dts": "^0.28.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "keywords": [
    "chemistry",
    "chemical structure",
    "molecule editor",
    "chemdraw",
    "markush",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxyhgk/structura.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/wxyhgk/structura#readme",
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
