{
  "name": "@structura/testkit",
  "version": "0.1.0",
  "private": true,
  "description": "Structura 测试共用的工具：执行操作、构造候选项、带种子的随机数、几何检查、按 RDKit 标准 SMILES 比较结构、模拟画布、边界测试的导入解析。只给测试用，产品代码不得引用。",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./chem": "./src/chem.ts",
    "./engine": "./src/engine.ts",
    "./arch": "./src/arch.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types --conditions=structura-source --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@rdkit/rdkit": "^2026.3.6",
    "@structura/core": "*",
    "@structura/engine": "*"
  }
}
